# MongoDB connection URI
MONGODB_URI=

# JWT secret for token generation (deprecated, use AUTH_SECRET instead)
JWT_SECRET=

# Session authentication secret (required for authentication)
AUTH_SECRET=your-very-long-random-secret-key-at-least-32-characters

# Application public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication development mode (set to 'true' to see OTP in console during development)
AUTH_DEV_MODE=true

# Razorpay Payment Gateway
# Get credentials from https://dashboard.razorpay.com/app/keys
# Server-side only (never expose secret to browser)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public key for browser (safe to expose)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
