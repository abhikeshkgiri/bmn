# MongoDB connection URI
MONGODB_URI=

# Session authentication secret (required for authentication)
AUTH_SECRET=your-very-long-random-secret-key-at-least-32-characters

# Application public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development-only authentication mode. Must be false or unset in production.
AUTH_DEV_MODE=false

# OTP Provider Configuration
# Production: twilio. Development may use development or mock.
OTP_PROVIDER=twilio

# Twilio OTP Provider (only needed if OTP_PROVIDER=twilio)
# Get credentials from https://www.twilio.com/console
OTP_TWILIO_ACCOUNT_SID=
OTP_TWILIO_AUTH_TOKEN=
OTP_TWILIO_FROM_NUMBER=+1234567890

# Razorpay Payment Gateway
# Get credentials from https://dashboard.razorpay.com/app/keys
# Server-side only (never expose secret to browser)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public key for browser (safe to expose)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Web Push (optional until push is enabled; required for actual delivery)
PUSH_VAPID_SUBJECT=https://your-domain.example
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=