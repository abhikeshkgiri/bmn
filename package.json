{
  "name": "bookmynai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/next-runner.js dev",
    "build": "node ./scripts/next-runner.js build",
    "start": "node ./scripts/next-runner.js start",
    "lint": "eslint",
    "test:db": "node -r ts-node/register/transpile-only -r tsconfig-paths/register -e \"require('./scripts/test-db.ts')\"",
    "seed": "node -r ts-node/register/transpile-only -r tsconfig-paths/register -e \"require('./scripts/seed.ts')\"",
    "seed:demo": "node -r ts-node/register/transpile-only -r tsconfig-paths/register -e \"require('./scripts/seed-demo.ts')\"",
    "seed:demo:reset": "node -r ts-node/register/transpile-only -r tsconfig-paths/register -e \"require('./scripts/seed-demo.ts')\" --reset"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jose": "^6.2.8",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.31.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.2",
    "next": "16.3.1",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
